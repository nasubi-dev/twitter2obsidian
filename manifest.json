{
  "manifest_version": 2,
  "name": "Twitter to Obsidian",
  "version": "1.0.0",
  "description": "Save Twitter/X tweets to Obsidian vault using Local REST API",
  "icons": {
    "48": "icons/favicon.ico",
    "64": "icons/favicon.ico"
  },
  "permissions": [
    "storage",
    "notifications",
    "tabs",
    "https://x.com/*",
    "https://twitter.com/*",
    "https://127.0.0.1/*",
    "https://localhost/*",
    "http://127.0.0.1/*",
    "http://localhost/*"
  ],
  "commands": {
    "save-tweet": {
      "suggested_key": {
        "default": "Alt+O"
      },
      "description": "Save current tweet to Obsidian"
    }
  },
  "page_action": {
    "default_icon": "icons/favicon.ico",
    "default_title": "Save tweet to Obsidian",
    "show_matches": ["*://x.com/*/status/*", "*://twitter.com/*/status/*"]
  },
  "options_ui": {
    "page": "options.html",
    "browser_style": true
  },
  "background": {
    "scripts": ["background.js"]
  },
  "content_scripts": [
    {
      "matches": ["*://x.com/*", "*://twitter.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "twitter2obsidian@example.com",
      "strict_min_version": "109.0"
    }
  }
}
